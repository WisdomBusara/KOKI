# Copy this file to .env.local and fill in the values. .env* is gitignored.

# --- Phase 1: MongoDB ---
# Atlas free tier (https://www.mongodb.com/atlas) or a local mongod.
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/koki?retryWrites=true&w=majority"
# Only if your network's DNS refuses SRV lookups (mongodb+srv). Leave unset in production.
# MONGODB_DNS_SERVERS="8.8.8.8,1.1.1.1"

# --- Storefront ---
# Public site URL (metadata / absolute URLs). Build-time.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp order number, international format, no "+".
NEXT_PUBLIC_WHATSAPP_NUMBER="2547XXXXXXXX"

# --- Phase 3: M-Pesa (Daraja) — fill when wiring checkout ---
# MPESA_ENV="sandbox"            # sandbox | production
# MPESA_CONSUMER_KEY=""
# MPESA_CONSUMER_SECRET=""
# MPESA_SHORTCODE=""             # Lipa na M-Pesa shortcode / till
# MPESA_PASSKEY=""
# MPESA_CALLBACK_URL=""          # public https URL to /api/mpesa/callback

# --- Cloudinary (product images, unsigned upload widget in the admin) ---
# From your Cloudinary dashboard. The upload preset must be "Unsigned".
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- Phase 4: Auth.js (admin login) ---
# AUTH_SECRET=""                 # generate with: npx auth secret
