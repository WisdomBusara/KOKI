# KOKI production env — copy to the project root on the VPS as `.env.production`
# and fill in. NEXT_PUBLIC_* are baked in at BUILD time, so set them BEFORE
# `npm run build`. Server-side values are read at start by `next start`.

# Public site URL (used for metadata / absolute URLs). Build-time.
NEXT_PUBLIC_SITE_URL="https://koki.wisdombusara.com"

# MongoDB on the VPS (same box as KOKI). If the mongo instance requires auth:
MONGODB_URI="mongodb://koki_user:CHANGE_ME@127.0.0.1:27017/koki?authSource=admin"
# If it has no auth / is bound to localhost only: mongodb://127.0.0.1:27017/koki
# If mongo runs in Docker, make sure it publishes 27017 on 127.0.0.1 (or use the
# container host). Create the `koki` db + user first, then run the seed scripts.
# Do NOT set MONGODB_DNS_SERVERS for a local mongo.
#
# (Atlas alternative, if you ever switch back:)
# MONGODB_URI="mongodb+srv://USER:PASS@cluster0.qqym77j.mongodb.net/koki?retryWrites=true&w=majority"

# WhatsApp order number (international, no +). Build-time.
NEXT_PUBLIC_WHATSAPP_NUMBER="2547XXXXXXXX"

# Admin auth
AUTH_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""
ADMIN_EMAIL="ianmwaura@gmail.com"
ADMIN_PASSWORD="set-a-strong-password"

# M-Pesa (Daraja). This subdomain finally gives the callback a real home:
MPESA_ENV="sandbox"                 # switch to "production" after go-live
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"            # sandbox; real paybill/till for production
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"
MPESA_CALLBACK_URL="https://koki.wisdombusara.com/api/mpesa/callback"

# Cloudinary image uploads (build-time). Unsigned upload preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
